<resources>
    <!-- Initial light theme before Compose applies the runtime theme. -->
    <style name="Theme.Visto" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/launcher_icon_background</item>
        <item name="android:statusBarColor">@color/launcher_icon_background</item>
        <item name="android:navigationBarColor">@color/launcher_icon_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
